{
    "name": "satyabuilds-lab",
    "private": true,
    "workspaces": [
        "apps/cosmo-music-visualizer",
        "apps/production-panic",
        "apps/the-stars-remain",
        "site"
    ],
    "scripts": {
        "dev:site": "npm run dev --workspace=@satyabuilds/site",
        "dev:cosmo-music-visualizer": "npm run dev --workspace=cosmos-music-visualizer-argon",
        "dev:dyson-sphere": "vite apps/dyson-sphere/site --host 127.0.0.1 --port 5174",
        "dev:pelagic": "vite apps/pelagic/site --host 127.0.0.1 --port 5177",
        "dev:production-panic": "npm run dev --workspace=production-panic",
        "dev:the-stars-remain": "npm run dev --workspace=the-stars-remain",
        "build:site": "npm run build --workspace=@satyabuilds/site",
        "build:cosmo-music-visualizer": "npm run build --workspace=cosmos-music-visualizer-argon",
        "build:production-panic": "npm run build --workspace=production-panic",
        "build:the-stars-remain": "npm run build --workspace=the-stars-remain",
        "build:static": "npm run build:site && npm run build:cosmo-music-visualizer && npm run build:production-panic && npm run build:the-stars-remain && node scripts/build-static.mjs",
        "build": "npm run build:static",
        "preview": "npm run build:static && wrangler dev",
        "deploy": "npm run build:static && wrangler deploy"
    },
    "devDependencies": {
        "wrangler": "^4.0.0"
    }
}
