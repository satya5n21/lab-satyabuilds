{
    "name": "satyabuilds-lab",
    "private": true,
    "workspaces": [
        "apps/cosmic-timeline-btn",
        "apps/cosmo-music-visualizer",
        "apps/production-panic",
        "apps/the-stars-remain",
        "apps/VERYA-planet-of-living-light"
    ],
    "scripts": {
        "capture": "node scripts/capture-stills.mjs",
        "dev:site": "node scripts/dev-hub.mjs",
        "dev:cosmo-music-visualizer": "npm run dev --workspace=cosmos-music-visualizer-argon",
        "dev:dyson-sphere": "vite apps/dyson-sphere/site --host 127.0.0.1 --port 5174",
        "dev:pelagic": "vite apps/pelagic/site --host 127.0.0.1 --port 5177",
        "dev:starship-success": "vite apps/starship-success/site --host 127.0.0.1 --port 5178",
        "dev:production-panic": "npm run dev --workspace=production-panic",
        "dev:the-stars-remain": "npm run dev --workspace=the-stars-remain",
        "build:site": "node scripts/build-hub.mjs",
        "build:cosmo-music-visualizer": "npm run build --workspace=cosmos-music-visualizer-argon",
        "build:production-panic": "npm run build --workspace=production-panic",
        "build:the-stars-remain": "npm run build --workspace=the-stars-remain",
        "build:static": "npm run build:cosmo-music-visualizer && npm run build:production-panic && npm run build:the-stars-remain && npm run build:cosmic-timeline-btn && npm run build:verya-planet-of-living-light && npm run build:site && node scripts/build-static.mjs",
        "build": "npm run build:static",
        "preview": "npm run build:static && wrangler dev",
        "deploy": "npm run build:static && wrangler deploy",
        "dev:cosmic-timeline-btn": "npm run dev --workspace=cosmic-timeline-btn",
        "build:cosmic-timeline-btn": "npm run build --workspace=cosmic-timeline-btn",
        "dev:verya-planet-of-living-light": "npm run dev --workspace=veyra-planet-of-the-living-light",
        "build:verya-planet-of-living-light": "npm run build --workspace=veyra-planet-of-the-living-light"
    },
    "devDependencies": {
        "wrangler": "^4.0.0"
    }
}
